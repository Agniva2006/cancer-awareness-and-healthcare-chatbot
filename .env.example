# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# JWT signing secret — MUST be >= 32 random chars in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Billing (Phase 3) — Stripe TEST keys first; live keys only in production.
# Create products/prices in the Stripe dashboard, then paste the price IDs.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx        # Pro monthly $9
STRIPE_PRICE_CLINIC=price_xxx     # Clinic monthly $49
BILLING_PROVIDER=stripe
FREE_PLAN_QUOTA=20
APP_BASE_URL=http://localhost:8000

# Database (defaults to a local SQLite file if unset).
# With docker compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cancer_chatbot

# Optional: comma-separated list of origins allowed to call the API.
# Leave unset to use the built-in localhost defaults.
ALLOWED_ORIGINS=http://localhost:5501,http://127.0.0.1:5501

# NVIDIA NIM (OpenAI-compatible) API key for nvdia.py smoke test
# Get a free key at https://build.nvidia.com (keys start with "nvapi-")
NVIDIA_API_KEY=your_nvidia_api_key_here

